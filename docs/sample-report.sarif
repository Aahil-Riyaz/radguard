            {
              "id": "pixels.slack",
              "name": "PixelsSlack",
              "shortDescription": {
                "text": "Data after the last pixel"
              },
              "fullDescription": {
                "text": "Pixel Data is longer than the image the header describes. Viewers that honour the header never display the extra bytes, while lenient decoders (pydicom among them) return them as extra frames: hidden data, or a hidden image. Severity rises with size, entropy and recognised content."
              },
              "help": {
                "text": "Extract the bytes at the reported offset (`radguard map` shows the file's layout) and identify them. Conforming software never stores data where readers do not look, so the content is either a writer bug or deliberately hidden.",
                "markdown": "Pixel Data is longer than the image the header describes. Viewers that honour the header never display the extra bytes, while lenient decoders (pydicom among them) return them as extra frames: hidden data, or a hidden image. Severity rises with size, entropy and recognised content.\n\n**What to do:** Extract the bytes at the reported offset (`radguard map` shows the file's layout) and identify them. Conforming software never stores data where readers do not look, so the content is either a writer bug or deliberately hidden."
              },
              "helpUri": "https://github.com/Aahil-Riyaz/radguard/blob/main/docs/rules.md#pixelsslack",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "hidden-data",
                  "external/cwe/cwe-514",
                  "external/cwe/cwe-436"
                ],
                "precision": "very-high",
