            {
              "id": "pixels.size-overflow",
              "name": "PixelsSizeOverflow",
              "shortDescription": {
                "text": "Image size overflows 32-bit arithmetic"
              },
              "fullDescription": {
                "text": "Rows x Columns x Samples x Frames x Bits needs 4 GiB or more. A decoder that computes the size in 32 bits allocates a small buffer and then writes the full image into it: a heap overflow."
              },
              "help": {
                "text": "Open the file only with current, sandboxed decoders: this is the input class behind decoder memory-safety bugs. Quarantine it and trace its source, because crafted headers like this rarely occur by accident.",
                "markdown": "Rows x Columns x Samples x Frames x Bits needs 4 GiB or more. A decoder that computes the size in 32 bits allocates a small buffer and then writes the full image into it: a heap overflow.\n\n**What to do:** Open the file only with current, sandboxed decoders: this is the input class behind decoder memory-safety bugs. Quarantine it and trace its source, because crafted headers like this rarely occur by accident."
              },
              "helpUri": "https://github.com/Aahil-Riyaz/radguard/blob/main/docs/rules.md#pixelssize-overflow",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "memory-safety",
                  "external/cwe/cwe-190",
                  "external/cwe/cwe-787"
                ],
                "precision": "very-high",
                "security-severity": "8.0"
              },
              "relationships": [
