            {
              "id": "pixels.invalid-geometry",
              "name": "PixelsInvalidGeometry",
              "shortDescription": {
                "text": "Zero or negative image dimension"
              },
              "fullDescription": {
                "text": "The image header declares a zero or negative dimension (Number of Frames is text, so \"0\" or \"-5\" is easy to write). Decoders disagree on what, if anything, to render, and size arithmetic on such values is a classic source of decoder bugs."
              },
              "help": {
                "text": "Open the file only with current, sandboxed decoders: this is the input class behind decoder memory-safety bugs. Quarantine it and trace its source, because crafted headers like this rarely occur by accident.",
                "markdown": "The image header declares a zero or negative dimension (Number of Frames is text, so \"0\" or \"-5\" is easy to write). Decoders disagree on what, if anything, to render, and size arithmetic on such values is a classic source of decoder bugs.\n\n**What to do:** Open the file only with current, sandboxed decoders: this is the input class behind decoder memory-safety bugs. Quarantine it and trace its source, because crafted headers like this rarely occur by accident."
              },
              "helpUri": "https://github.com/Aahil-Riyaz/radguard/blob/main/docs/rules.md#pixelsinvalid-geometry",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "memory-safety",
                  "external/cwe/cwe-1284"
                ],
                "precision": "very-high",
                "security-severity": "5.5"
              },
              "relationships": [
                {
                  "target": {
                    "id": "1284",
