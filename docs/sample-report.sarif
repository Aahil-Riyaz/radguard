              "id": "sarif.results-omitted",
              "name": "SarifResultsOmitted",
              "shortDescription": {
                "text": "Least severe results omitted"
              },
              "fullDescription": {
                "text": "GitHub code scanning rejects a run with more than 25,000 results, so the most severe ones were kept. The JSON report lists every finding."
              },
              "help": {
                "text": "Use the JSON report (--format json) for the complete list, or scan fewer files per run."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            }
