              "name": "PrivateUnusableElement",
              "shortDescription": {
                "text": "Private element outside any reservable block"
              },
              "fullDescription": {
                "text": "Only Private Creators (gggg,0010-00FF) and private data elements (gggg,1000-FFFF) are defined, so no reader can interpret an element elsewhere in a private group, and every reader skips it."
