            {
              "id": "structure.hidden-payload",
              "name": "StructureHiddenPayload",
              "shortDescription": {
                "text": "File hidden outside the DICOM structure"
              },
              "fullDescription": {
                "text": "Bytes the DICOM structure cannot account for contain a recognised file format, typically an executable appended after the dataset or left behind a broken element. DICOM readers never display these bytes; other programs can run or extract them. High rather than critical when the payload is an archive, a script or a document rather than an executable."
              },
              "help": {
                "text": "Quarantine the file and keep it away from anything that could run or extract the embedded content. Extract the payload at the reported offset for malware analysis, find out how the file entered the archive, and check other files from the same source. Re-saving the file in a viewer is not a fix: it may keep the payload, and it destroys evidence.",
                "markdown": "Bytes the DICOM structure cannot account for contain a recognised file format, typically an executable appended after the dataset or left behind a broken element. DICOM readers never display these bytes; other programs can run or extract them. High rather than critical when the payload is an archive, a script or a document rather than an executable.\n\n**What to do:** Quarantine the file and keep it away from anything that could run or extract the embedded content. Extract the payload at the reported offset for malware analysis, find out how the file entered the archive, and check other files from the same source. Re-saving the file in a viewer is not a fix: it may keep the payload, and it destroys evidence."
              },
              "helpUri": "https://github.com/Aahil-Riyaz/radguard/blob/main/docs/rules.md#structurehidden-payload",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "malware",
                  "external/cwe/cwe-506"
                ],
                "precision": "high",
                "security-severity": "9.5"
              },
