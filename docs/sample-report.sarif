            {
              "id": "values.embedded-file",
              "name": "ValuesEmbeddedFile",
              "shortDescription": {
                "text": "File embedded in an attribute value"
              },
              "fullDescription": {
                "text": "A recognised file format sits inside an attribute value: a private blob, an unknown-VR value, an item deep in a sequence. Executables have no business in any attribute (critical), scripts are high and archives medium; documents and markup are routine vendor practice and reported as low for review."
              },
              "help": {
                "text": "Quarantine the file and keep it away from anything that could run or extract the embedded content. Extract the payload at the reported offset for malware analysis, find out how the file entered the archive, and check other files from the same source. Re-saving the file in a viewer is not a fix: it may keep the payload, and it destroys evidence.",
                "markdown": "A recognised file format sits inside an attribute value: a private blob, an unknown-VR value, an item deep in a sequence. Executables have no business in any attribute (critical), scripts are high and archives medium; documents and markup are routine vendor practice and reported as low for review.\n\n**What to do:** Quarantine the file and keep it away from anything that could run or extract the embedded content. Extract the payload at the reported offset for malware analysis, find out how the file entered the archive, and check other files from the same source. Re-saving the file in a viewer is not a fix: it may keep the payload, and it destroys evidence."
              },
              "helpUri": "https://github.com/Aahil-Riyaz/radguard/blob/main/docs/rules.md#valuesembedded-file",
              "defaultConfiguration": {
                "level": "error"
              },
