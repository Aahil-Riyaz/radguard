                }
              ]
            },
            {
              "id": "preamble.elf-polyglot",
              "name": "PreambleElfPolyglot",
              "shortDescription": {
                "text": "ELF executable header in the preamble"
              },
              "fullDescription": {
                "text": "The 128-byte preamble is the first thing any non-DICOM program reads, and PS3.10 leaves it free for application use, so it can make one file two formats at once. An ELF header needs only its magic at byte 0, so the file runs on Linux-based devices while remaining a valid image (ELFDICOM)."
              },
              "help": {
                "text": "Quarantine the file and keep it away from anything that could run or extract the embedded content. Extract the payload at the reported offset for malware analysis, find out how the file entered the archive, and check other files from the same source. Re-saving the file in a viewer is not a fix: it may keep the payload, and it destroys evidence.",
                "markdown": "The 128-byte preamble is the first thing any non-DICOM program reads, and PS3.10 leaves it free for application use, so it can make one file two formats at once. An ELF header needs only its magic at byte 0, so the file runs on Linux-based devices while remaining a valid image (ELFDICOM).\n\n**What to do:** Quarantine the file and keep it away from anything that could run or extract the embedded content. Extract the payload at the reported offset for malware analysis, find out how the file entered the archive, and check other files from the same source. Re-saving the file in a viewer is not a fix: it may keep the payload, and it destroys evidence.\n\n**References:**\n- <https://www.praetorian.com/blog/elfdicom-poc-malware-polyglot-exploiting-linux-based-medical-devices/>"
              },
              "helpUri": "https://github.com/Aahil-Riyaz/radguard/blob/main/docs/rules.md#preambleelf-polyglot",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "malware",
                  "external/cwe/cwe-506",
                  "external/cwe/cwe-436"
                ],
                "precision": "very-high",
