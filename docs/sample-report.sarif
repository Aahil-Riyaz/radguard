            {
              "id": "pixels.truncated",
              "name": "PixelsTruncated",
              "shortDescription": {
                "text": "Pixel Data shorter than the image it describes"
              },
              "fullDescription": {
                "text": "Decoders that trust the header read past the end of the pixel buffer."
              },
              "help": {
                "text": "Open the file only with current, sandboxed decoders: this is the input class behind decoder memory-safety bugs. Quarantine it and trace its source, because crafted headers like this rarely occur by accident.",
                "markdown": "Decoders that trust the header read past the end of the pixel buffer.\n\n**What to do:** Open the file only with current, sandboxed decoders: this is the input class behind decoder memory-safety bugs. Quarantine it and trace its source, because crafted headers like this rarely occur by accident."
              },
              "helpUri": "https://github.com/Aahil-Riyaz/radguard/blob/main/docs/rules.md#pixelstruncated",
