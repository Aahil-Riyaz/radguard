          "notifications": [
            {
              "id": "scan.path-error",
              "name": "ScanPathError",
              "shortDescription": {
                "text": "A path could not be examined"
              },
              "fullDescription": {
                "text": "A file or directory could not be read, or a check failed on it. The scan is incomplete: the absence of results for this path is not evidence that it is clean."
              },
              "help": {
                "text": "Fix the cause given in the message (permissions, a file that changed or disappeared, a Git LFS pointer) and scan again. Until then, treat the path as not scanned."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "scan.path-skipped",
              "name": "ScanPathSkipped",
              "shortDescription": {
                "text": "A path was deliberately not examined"
              },
              "fullDescription": {
                "text": "For example a symbolic link to a directory, which is not followed."
              },
              "help": {
                "text": "If the target should be covered, scan it directly."
              },
              "defaultConfiguration": {
