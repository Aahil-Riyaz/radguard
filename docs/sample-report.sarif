            {
              "id": "private.decompression-bomb",
              "name": "PrivateDecompressionBomb",
              "shortDescription": {
                "text": "Compressed private data too large to inspect"
              },
              "fullDescription": {
                "text": "A compressed private value expands more than 1000:1, past the per-value limit or past the per-file budget. That is a decompression bomb aimed at tools that inflate private data, or data built to exceed analysis budgets; the part that was not inspected is not reported clean."
              },
              "help": {
                "text": "The file is built to exhaust the resources of software that processes it. Quarantine it, and check whether any system that ingested it (PACS, router, AI pipeline) slowed down or failed.",
                "markdown": "A compressed private value expands more than 1000:1, past the per-value limit or past the per-file budget. That is a decompression bomb aimed at tools that inflate private data, or data built to exceed analysis budgets; the part that was not inspected is not reported clean.\n\n**What to do:** The file is built to exhaust the resources of software that processes it. Quarantine it, and check whether any system that ingested it (PACS, router, AI pipeline) slowed down or failed."
              },
              "helpUri": "https://github.com/Aahil-Riyaz/radguard/blob/main/docs/rules.md#privatedecompression-bomb",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "resource",
                  "external/cwe/cwe-409"
                ],
                "precision": "high",
